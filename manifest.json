{
  "manifest_version": 3,
  "name": "CSDN Markdown 图片自动上传 - 图随文走",
  "short_name": "图随文走",
  "version": "1.0.0",
  "description": "CSDN Markdown 编辑器一键导入 .md 并自动上传图片：正文和图一起进来，图片自动换成 CSDN 图床直链，写博客发文章不用再手动传图。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://editor.csdn.net/*"],
      "js": ["csdn.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
